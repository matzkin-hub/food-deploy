%header.sticky-top.bg-warning.border-bottom.border-3.border-dark
  .container.d-flex.align-items-center.justify-content-between.py-2
    = link_to ingredients_path, class: 'navbar-brand d-flex align-items-center gap-2 fw-bolder fs-3 m-0' do
      %span.badge.rounded-circle.text-bg-danger.border.border-3.border-dark.fs-5
        %i.bi.bi-basket3-fill
      food
    .d-flex.align-items-center.gap-2
      - if user_signed_in?
        = button_to destroy_user_session_path, method: :delete, data: {turbo_confirm: '本当にログアウトしますか？'}, class: pop_btn('light', 'btn-sm') do
          %i.bi.bi-box-arrow-right
          ログアウト
      - else
        = link_to 'ログイン', new_user_session_path, class: pop_btn('light', 'btn-sm')
        = link_to '新規登録', new_user_registration_path, class: pop_btn('danger', 'btn-sm')
