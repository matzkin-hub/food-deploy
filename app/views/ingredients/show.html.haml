%h1 詳細画面
=link_to '賞味期限/個数', new_ingredient_ingredient_stock_path(@ingredient), class: 'btn btn-success'
%table.table
  %thead
    %tr
      %th 賞味期限
      %th 個数
      %th 削除
      %th 編集    
  %tbody 
  - @ingredient.ingredient_stocks.order(expire_on: :desc).each do |stock|
    %tr
      %td= stock.expire_on
      %td= stock.quantity 
      %td= button_to '削除', ingredient_ingredient_stock_path(@ingredient, stock), method: :delete, data: {turbo_confirm: '本当に削除しますか？'},class: 'btn btn-danger'
      %td= link_to '編集',  edit_ingredient_ingredient_stock_path(@ingredient, stock), class: 'btn btn-info'