.container
  %h2 ログイン
  = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .form-inputs
      = f.input :email, required: false,autofocus: true,input_html: { autocomplete: "メールアドレス" }
      = f.input :password,required: false,  input_html: { autocomplete: "パスワード" }
    .form-actions
      = f.button :submit, "ログイン", class: 'btn btn-success'
