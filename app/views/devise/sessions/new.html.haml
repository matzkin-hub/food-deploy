.row.justify-content-center
  .col-12.col-md-8.col-lg-5
    %div{class: pop_card}
      .card-body.p-4
        %h2 ログイン
        = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
          .form-inputs
            = f.input :email, required: false, autofocus: true, input_html: { class: 'border-3 border-dark', autocomplete: "メールアドレス" }
            = f.input :password, required: false, input_html: { class: 'border-3 border-dark', autocomplete: "パスワード" }
          = f.hidden_field :remember_me, value: 1
          .form-actions
            = f.button :submit, "ログイン", class: pop_btn('danger', 'w-100 mt-2')
