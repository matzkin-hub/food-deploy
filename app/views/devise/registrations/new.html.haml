.row.justify-content-center
  .col-12.col-md-8.col-lg-5
    %div{class: pop_card}
      .card-body.p-4
        %h2 新規登録
        = simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
          = f.error_notification
          .form-inputs
            = f.input :email, required: true, autofocus: true,input_html: { class: 'border-3 border-dark', autocomplete: "メールアドレス" } 
            = f.input :password,required: true,hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length), input_html: { class: 'border-3 border-dark', autocomplete: "new-password" }                    
            = f.input :password_confirmation,required: true,input_html: { class: 'border-3 border-dark', autocomplete: "new-password" } 
          .form-actions
            = f.button :submit, "新規登録", class: pop_btn('danger', 'w-100 mt-2')
