.row.justify-content-center
  .col-12.col-md-8.col-lg-5
    %div{class: pop_card}
      .card-body.p-4
        = simple_form_for [ingredient, ingredient_stock] do |f|
          = f.input :quantity, as: :select, collection: (0..99), input_html: { class: 'border-3 border-dark' }
          = f.input :expire_on, as: :date, html5: true, wrapper: :vertical_form, input_html: { class: 'border-3 border-dark' }
          = f.button :submit, class: pop_btn('danger', 'w-100 mt-2')
